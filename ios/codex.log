        guard let draft, let supporter = store.supporter(draft.supporterID) else { return nil }
        return "仕事探してるって言ってたよね。'"\\(supporter.name)さんが転職の相談乗ってくれるから、よかったら話してみて → tsunagu://ref/\\(draft.id.uuidString)\"
    }
    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 18) {
                Text(\"友達と支援者をつなぐ\").font(.title2.bold())
